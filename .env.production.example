# Production configuration. Usage:
#   cp .env.production.example .env
#   (edit the values below)
#   docker compose up -d --build
#
# .env holds secrets: keep it out of version control and restrict it (chmod 0600 where supported).
# Internet-facing deployments should sit behind a TLS-terminating reverse proxy.

# Bootstrap Administrator, created once on an empty database (required).
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=

# Token issuer and audience that consumer APIs validate (required).
Jwt__Issuer=
Jwt__Audience=

# Allowed browser origin, e.g. https://app.example.com (required; scheme+host[:port], no trailing slash).
Cors__AllowedOrigins__0=

# Host port for the API.
API_PORT=8080

# Apply pending database migrations automatically at startup.
Database__MigrateOnStartup=true
