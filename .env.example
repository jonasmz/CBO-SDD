# Copy this file to .env. It is Compose's normal authoritative configuration.
# A .env containing secrets must stay out of version control and be mode 0600 where supported.
# In production, prefer mounted secret files or the platform secret mechanism for the PFX password
# and bootstrap Administrator password: environment variables can be visible through container inspection.

# Development Compose files: loads the development/tooling services (dev, dev-api, tools) on top of the
# production compose.yaml, so `docker compose run dev ...` keeps working without -f flags.
# Production deployments use .env.production.example instead and do not set this.
COMPOSE_FILE=compose.yaml:compose.dev.yaml

# Required for development: absolute repository path as seen by the host Docker daemon, not an agent container path.
HOST_PROJECT_DIR=

# Development-container identity only (dev, dev-api and local validation helpers).
# This identity is independent of APP_UID/APP_GID and must never be used by production runtime containers.
LOCAL_UID=1000
LOCAL_GID=1000

# Host ports for people; agent checks use the Compose network via the tools service instead.
API_PORT=8080
DEV_API_PORT=8081

# ADVANCED / OPTIONAL: absolute host directory containing external PEM/PFX signing material, mounted
# read-only into auth-api. Leave unset unless using an externally managed signing key.
SIGNING_KEY_DIR=

# ADVANCED / OPTIONAL. Production/runtime-container identity only (default 10001:10001 when unset). These are independent of LOCAL_UID/LOCAL_GID and must not be mixed.
# The documented runtime defaults are 10001:10001; deployment configuration and these values are authoritative
# when Compose is used. Any Compose :-1000 LOCAL_* fallback is only a safe development default.
APP_UID=10001
APP_GID=10001

# Bootstrap Administrator configuration (supply externally; do not commit real values).
Bootstrap__AdminEmail=
Bootstrap__AdminPassword=

# JWT configuration placeholders (supply externally; do not commit signing material or passwords).
Jwt__Issuer=
Jwt__Audience=
Jwt__AccessTokenMinutes=15
Jwt__Signing__PrivateKeyPemPath=
Jwt__Signing__CertificatePath=
Jwt__Signing__CertificatePassword=
